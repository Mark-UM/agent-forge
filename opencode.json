{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "write": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "AGENTS_COMPOSED.md",
    "markconfig/profile.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "_state/**",
      "_runtime/**",
      "vendor/**",
      "__pycache__/**",
      ".opencode/skills/**/node_modules/**",
      ".opencode/skills/**/.git/**"
    ]
  },
  "plugin": [
    "oh-my-opencode@latest",
    "@tarquinen/opencode-dcp",
    "opencode-antigravity-auth@latest"
  ],
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 30000
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "_runtime/mcp-memory.json"
      },
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "fetch": {
      "type": "local",
      "command": ["python", "-m", "modules.mcp.fetch_mcp", "serve"],
      "enabled": true,
      "timeout": 30000
    },
    "sqlite": {
      "type": "local",
      "command": ["python", "-m", "modules.mcp.sqlite_mcp", "serve", "--db-path", "_runtime/mcp-sqlite.db"],
      "enabled": true,
      "timeout": 30000
    },
    "time": {
      "type": "local",
      "command": ["python", "-m", "modules.mcp.time_mcp", "serve"],
      "enabled": true,
      "timeout": 30000
    },
    "git": {
      "type": "local",
      "command": ["python", "-m", "mcp_server_git", "--repository", "."],
      "enabled": true,
      "timeout": 10000
    },
    "duckduckgo": {
      "type": "local",
      "command": ["python", "-m", "duckduckgo_mcp_server"],
      "enabled": false,
      "timeout": 30000
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "https://searx.be"
      },
      "enabled": true,
      "timeout": 30000
    },
    "g-search": {
      "type": "local",
      "command": ["npx", "-y", "g-search-mcp"],
      "enabled": false,
      "timeout": 60000
    },
    "serper": {
      "type": "local",
      "command": ["python", "-m", "modules.search.serper_mcp", "serve"],
      "environment": {
        "SERPER_API_KEY": "{env:SERPER_API_KEY}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "arxiv": {
      "type": "local",
      "command": ["python", "-m", "modules.search.arxiv_mcp", "serve"],
      "enabled": true,
      "timeout": 30000
    },
    "semantic_scholar": {
      "type": "local",
      "command": ["python", "-m", "modules.search.semantic_scholar_mcp", "serve"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
